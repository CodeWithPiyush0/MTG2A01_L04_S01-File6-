   "vo_t4_built": "बहुत बढ़िया! आपने ब्लॉक्स से संख्या चौंतीस बना ली।",
   "vo_t4_digits": "34 में 3 दहाई और 4 इकाई हैं।",
   "vo_t4_intro": "अब आप ब्लॉक्स की सहायता से 34 बनाइए।",
   "vo_t4_ones": "अब 4 इकाई के लिए 4 ब्लॉक्स रखिए।",
   "vo_t4_ones_left": "4 इकाई में से 1 इकाई घटाने पर बचीं, 3 इकाई।",
   "vo_t4_rm_ones": "पहले आप इकाइयाँ घटाइए। 4 इकाई में से 1 इकाई हटाइए।",
   "vo_t4_rm_tens": "अब आप दहाइयाँ घटाइए। 3 दहाई में से 2 दहाई हटाइए।",
   "vo_t4_story_a": "यहाँ हमने चौंतीस में से इक्कीस घटाए हैं, तो बचे 13।",
   "vo_t4_story_c": "यानी रोहन के पास कुल 13 ब्लॉक्स बचे।",
   "vo_t4_sub": "अब 34 में से 21 घटाते हैं। 21 में 2 दहाई और 1 इकाई होते हैं।",
   "vo_t4_tens": "3 दहाई के लिए 3 बंडल रखिए।",
   "vo_t4_tens_left": "बहुत बढ़िया! 3 दहाई में से 2 दहाई घटाने पर बचे, 1 दहाई।",
   "vo_t4_total": "34 में से 21 घटाने पर हमें मिलीं, 1 दहाई और 3 इकाई, यानी 13",
